{
  "name": "hydrahub",
  "productName": "HydraHub",
  "version": "1.1.1",
  "description": "HydraHub — tutoriais, links e instalador de jogos recompilados, tudo em um só lugar.",
  "author": "HydraHub",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "catalog": "node scraper/build-catalog.mjs",
    "catalog:quick": "node scraper/build-catalog.mjs --quick",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hydrahub.app",
    "publish": [
      {
        "provider": "github",
        "owner": "achadoia",
        "repo": "hydrahub",
        "releaseType": "release"
      }
    ],
    "productName": "HydraHub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "catalog/catalog.json",
      "catalog/repos.json",
      "catalog/stats.json",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "HydraHub-Setup-${version}.exe",
      "shortcutName": "HydraHub",
      "uninstallDisplayName": "HydraHub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
